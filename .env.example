# --- database ---
# host 5433 (not 5432): this machine already has a native Postgres on 5432,
# so docker-compose publishes the project's Postgres on 5433 instead.
DATABASE_URL=postgresql://skynet:skynet@localhost:5433/skynet

# --- telegram (Telethon user session + bot for share-intake/alerts) ---
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_NAME=skynet
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
TELEGRAM_JOB_CHANNELS=
TELEGRAM_OWNER_CHAT_ID=

# --- gmail api (read-only, LinkedIn job-alert label) ---
GMAIL_CREDENTIALS_PATH=credentials/gmail_oauth.json
GMAIL_TOKEN_PATH=credentials/gmail_token.json
GMAIL_LINKEDIN_LABEL=LinkedIn Job Alerts
GMAIL_LOOKBACK_DAYS=14

# --- google sheets ---
GOOGLE_SHEETS_CREDENTIALS_PATH=credentials/sheets_key.json
GOOGLE_SHEETS_ID=

# --- google drive (Mark IV serverless: stores generated resumes since ---
# --- GitHub Actions runners have no persistent disk between runs) ---
# Folder ID from the Drive folder's URL, in your own Drive — uploads go
# through OAuth as you (same client as Gmail above, see
# GMAIL_CREDENTIALS_PATH), not the Sheets service account, since Drive
# refuses files.create() for service accounts on a personal (non-Workspace)
# Google account. First run opens a one-time browser consent screen and
# saves the resulting token to GOOGLE_DRIVE_TOKEN_PATH (default
# credentials/drive_token.json) for reuse after that.
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_TOKEN_PATH=credentials/drive_token.json

# --- greenhouse / lever ---
GREENHOUSE_BOARD_TOKENS=openai,anthropic,stripe,databricks,airbnb,figma,scaleai,cloudflare,datadog,robinhood
LEVER_COMPANY_SLUGS=openai,anthropic,stripe,databricks,airbnb,figma,scaleai,cloudflare,datadog,robinhood

# --- llm provider ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_RATE_LIMIT_RPM=5
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# --- whatsapp cloud api (on-demand "paste a link" -> WhatsApp resume) ---
# See README's "Paste a job link" section for the one-time Meta developer
# app + test number setup this needs.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT_NUMBER=
