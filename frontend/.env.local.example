# --- database (same Neon project the Python pipeline writes to) ---
# Use the POOLED connection string here (not the direct/unpooled one used
# for `alembic upgrade head`) — serverless functions open many short-lived
# connections, which is exactly what Neon's pooler is for.
DATABASE_URL=

# --- session ---
# Any long random string — e.g. `openssl rand -hex 32`. Signs the login
# session JWT (frontend/lib/auth/session.ts).
SESSION_SECRET=

# --- password login ---
# Not secret (it's not the security boundary, the password is) — any
# username you like, e.g. "tarun".
AUTH_USERNAME=
# A base64-encoded bcrypt hash, never the plaintext password — base64, not
# the raw hash, because Next.js's env loader does shell-like $-expansion
# that corrupts a bcrypt hash's literal $2b$12$... segments otherwise.
# Generate both of the above locally with:
#   node scripts/hash-password.mjs
# (prompts for username + password in your own terminal, prints only the
# username and the encoded hash — the real password never has to be typed
# anywhere else, including chat).
AUTH_PASSWORD_HASH_B64=

# --- webauthn (Touch ID / Face ID) ---
# The domain the app is served from, no scheme/port — "localhost" for
# local dev, your real Vercel domain (e.g. skynet-tarun.vercel.app or a
# custom domain) in production. Must match exactly or WebAuthn will
# refuse the ceremony.
RP_ID=localhost
RP_NAME=SKYNET
# Full origin(s) WebAuthn will accept responses from, comma-separated if
# more than one (e.g. preview deployments) — e.g. http://localhost:3000
RP_ORIGIN=http://localhost:3000
